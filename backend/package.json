{
  "name": "doc2ai-backend",
  "version": "0.1.0",
  "description": "Doc2AI Backend API - Documentation to AI converter",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "start": "bun dist/app.js",
    "build": "tsc",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "db:push": "bunx drizzle-kit push",
    "test": "bun test --isolate",
    "test:watch": "bun test --isolate --watch",
    "test:coverage": "bun test --isolate --coverage",
    "lint": "bunx eslint src/",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check ."
  },
  "engines": {
    "bun": ">=1.1"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "2.2.2",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^4.10.0",
    "@types/bun": "^1.3.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "0.30.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.8.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0"
  },
  "keywords": [
    "documentation",
    "markdown",
    "converter",
    "ai",
    "sharepoint",
    "google-drive"
  ],
  "author": "Doc2AI"
}
